    call script row4_show
    call script row5_show
    call script row6_hide
    call script row7_hide
    call script row8_hide
    call script row9_hide
    call script row10_hide
  }
  if sel.cb_ng.iseq("6") {
    call script row1_show
    call script row2_show
    call script row3_show
    call script row4_show
    call script row5_show
    call script row6_show
    call script row7_hide
    call script row8_hide
    call script row9_hide
    call script row10_hide
  }
  if sel.cb_ng.iseq("7") {
    call script row1_show
    call script row2_show
    call script row3_show
    call script row4_show
    call script row5_show
    call script row6_show
    call script row7_show
    call script row8_hide
    call script row9_hide
    call script row10_hide
  }
  if sel.cb_ng.iseq("8") {
    call script row1_show
    call script row2_show
    call script row3_show
    call script row4_show
    call script row5_show
    call script row6_show
    call script row7_show
    call script row8_show
    call script row9_hide
    call script row10_hide
  }
  if sel.cb_ng.iseq("9") {
    call script row1_show
    call script row2_show
    call script row3_show
    call script row4_show
    call script row5_show
    call script row6_show
    call script row7_show
    call script row8_show
    call script row9_show
    call script row10_hide
  }
  if sel.cb_ng.iseq("10") {
    call script row1_show
    call script row2_show
    call script row3_show
    call script row4_show
    call script row5_show
    call script row6_show
    call script row7_show
    call script row8_show
    call script row9_show
    call script row10_show
  }
END

INCLUDE ifin
// the weights tab of Stata without the frequency weights (duvm refuses them:
// a household of the survey stands for its sampling weight)
INCLUDE weights
SCRIPT weights_POSTINIT_SCRIPT
BEGIN
  weights.rb_fw.hide
  weights.rb_pw.show
  weights.rb_aw.show
  weights.rb_iw.show
  weights.rb_pw.setposition . 50
  weights.rb_aw.setposition . 70
  weights.rb_iw.setposition . 90
  weights.tx_wgt.setposition . 120
  weights.vl_wgt.setposition . 140
END

DIALOG se, tabtitle("SE/Robust")
BEGIN
  GROUPBOX gb_v        10   10  640 245, label("Variance estimator")
  RADIO    rb_cluster  20   30  600   ., first label("Linearized, clustered by the price cluster (default)") onclickon(script se_off)
  RADIO    rb_svy      20   52  600   ., label("Linearized, survey design declared by svyset (PSU, strata, FPC, weight)") onclickon(script se_off)
  RADIO    rb_boot     20   74  600   ., label("Design bootstrap of both stages") onclickon(script se_on)
  RADIO    rb_none     20   96  600   ., last label("None (point estimates only)") onclickon(script se_off)

  TEXT     tx_reps     40  125  110   ., label("Replications:")
  EDIT     ed_reps    155  125   80   ., label("Replications") default(200) numonly
  TEXT     tx_seed    270  125   50   ., label("Seed:")
  EDIT     ed_seed    325  125   80   ., label("Seed") numonly
  CHECKBOX ck_bsvy     40  155  560   ., label("PSU, strata and weight from svyset") onclickon(script bsvy_on) onclickoff(script bsvy_off)
  TEXT     tx_strata   40  182  110   ., label("Strata:")
  VARNAME  vn_strata  155  182  170   ., label("Strata")
  TEXT     tx_psu     345  182   95   ., label("Resampled unit:")
  VARNAME  vn_psu     445  182  170   ., label("Resampled unit")
  TEXT     tx_psunote 155  205  470   ., label("(default: the price cluster)")
  CHECKBOX ck_short    40  228  560   ., label("Deaton's shortcut (the cluster-level file only; first stage held fixed)")
END

SCRIPT se_on
BEGIN
  se.tx_reps.enable
  se.ed_reps.enable
  se.tx_seed.enable
  se.ed_seed.enable
  se.ck_bsvy.enable
  se.ck_short.enable
  program bsvy_state
  rpt.ck_seall.enable
END
SCRIPT se_off
BEGIN
  se.tx_reps.disable
  se.ed_reps.disable
  se.tx_seed.disable
  se.ed_seed.disable
  se.ck_bsvy.disable
  se.ck_short.disable
  se.tx_strata.disable
  se.vn_strata.disable
  se.tx_psu.disable
  se.vn_psu.disable
  se.tx_psunote.disable
  program seall_state
END
SCRIPT bsvy_on
BEGIN
  se.tx_strata.disable
  se.vn_strata.disable
  se.tx_psu.disable
  se.vn_psu.disable
  se.tx_psunote.disable
END
SCRIPT bsvy_off
BEGIN
  program bsvy_state
END
PROGRAM bsvy_state
BEGIN
  if se.rb_boot & !se.ck_bsvy {
    call se.tx_strata.enable
    call se.vn_strata.enable
    call se.tx_psu.enable
    call se.vn_psu.enable
    call se.tx_psunote.enable
  }
  if !se.rb_boot | se.ck_bsvy {
    call script bsvy_on
  }
END
PROGRAM seall_state
BEGIN
  if se.rb_none {
    call rpt.ck_seall.disable
  }
  if !se.rb_none {
    call rpt.ck_seall.enable
  }
END

DIALOG rpt, tabtitle("Reporting")
BEGIN
  GROUPBOX gb_disp     10   10  640 150, label("Display")
  DEFINE _x 20
  DEFINE _cx 150
  DEFINE _y 30
  INCLUDE _sp_level
  TEXT     tx_dec     280   30  120   ., label("Decimals:")
  SPINNER  sp_dec     405   30   60   ., label("Decimals") min(0) max(8) default(3) option(dec)
  CHECKBOX ck_stars    20   58  610   ., label("Significance stars on the estimates, standard errors as Table N-b (stars)") option(stars)
  CHECKBOX ck_seall    20   80  610   ., label("Standard errors after every price-elasticity table (seall)") option(seall)
  CHECKBOX ck_dreg     20  102  610   ., label("Display the first-stage regressions")
  CHECKBOX ck_notab    20  124  610   ., label("Do not display the tables (the results stay in e())") option(notable)

  GROUPBOX gb_grp      10  170  640  55, label("Results by group")
  TEXT     tx_hgroup   20  192  250   ., label("Re-estimate within the groups of:")
  VARNAME  vn_hgroup  275  192  200   ., label("Groups") option(hgroup)

  GROUPBOX gb_save     10  235  640  70, label("Save the tables")
  TEXT     tx_save     20  255  620   ., label("File (the extension gives the format: .docx .tex .xlsx .csv .md):")
  FILE     fi_save     20  275  620   ., label("Browse...") save option(saveres) ///
           filter("Word (*.docx)|*.docx|LaTeX (*.tex)|*.tex|Excel (*.xlsx)|*.xlsx|CSV (*.csv)|*.csv|Markdown (*.md)|*.md")

  GROUPBOX gb_ref      10  315  640  87, label("Elasticities")
  RADIO    rb_hh       20  335  610   ., first label("Households (the default): each household counts for its weight")
  RADIO    rb_ind      20  357  610   ., label("Individuals: each household counts for its weight times its size (household size required)")
  RADIO    rb_mkt      20  379  610   ., last label("Market: at the aggregate budget shares, each household weighted by its expenditure")
END

PROGRAM command
BEGIN
  put "duvm "
  require main.ed_goods
  put main.ed_goods
  put " " /program ifin_output
  put " " /program weights_output
  beginoptions
    // household size: optional, required by the individuals and by compat
    if rpt.rb_ind | main.ck_compat {
      require main.vn_hhsize
    }
    optionarg main.vn_hhsize
    require main.vn_expend
    optionarg main.vn_expend
    require main.vn_cluster
    optionarg main.vn_cluster
    optionarg main.vn_region
    optionarg main.vn_sub
    optionarg main.vl_indcat
    optionarg main.vl_indcon
    optionarg /hidedefault main.ed_qother
    option main.ck_nosym
    if sel.ck_sel {
      put " selection"
      if sel.ed_selg {
        put " selgoods(" sel.ed_selg ")"
      }
      if sel.vl_v1 {
        require sel.ed_g1
      }
      if sel.ed_g1 {
        require sel.vl_v1
      }
      if sel.vl_v2 {
        require sel.ed_g2
      }
      if sel.ed_g2 {
        require sel.vl_v2
      }
      if sel.vl_v3 {
        require sel.ed_g3
      }
      if sel.ed_g3 {
        require sel.vl_v3
      }
      if sel.vl_v4 {
        require sel.ed_g4
      }
      if sel.ed_g4 {
        require sel.vl_v4
      }
      if sel.vl_v5 {
        require sel.ed_g5
      }
      if sel.ed_g5 {
        require sel.vl_v5
      }
      if sel.vl_v6 {
        require sel.ed_g6
      }
      if sel.ed_g6 {
        require sel.vl_v6
      }
      if sel.vl_v7 {
        require sel.ed_g7
      }
      if sel.ed_g7 {
        require sel.vl_v7
      }
      if sel.vl_v8 {
        require sel.ed_g8
      }
      if sel.ed_g8 {
        require sel.vl_v8
      }
      if sel.vl_v9 {
        require sel.ed_g9
      }
      if sel.ed_g9 {
        require sel.vl_v9
      }
      if sel.vl_v10 {
        require sel.ed_g10
      }
      if sel.ed_g10 {
        require sel.vl_v10
      }
      if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 | sel.ed_g8 | sel.ed_g9 | sel.ed_g10 {
        put " selvars("
        put sel.vl_all
        if sel.ed_g1 {
          if sel.vl_all {
            put "; "
          }
          put sel.ed_g1 ": " sel.vl_v1
        }
        if sel.ed_g2 {
          if sel.vl_all | sel.ed_g1 {
            put "; "
          }
          put sel.ed_g2 ": " sel.vl_v2
        }
        if sel.ed_g3 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 {
            put "; "
          }
          put sel.ed_g3 ": " sel.vl_v3
        }
        if sel.ed_g4 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 {
            put "; "
          }
          put sel.ed_g4 ": " sel.vl_v4
        }
        if sel.ed_g5 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 {
            put "; "
          }
          put sel.ed_g5 ": " sel.vl_v5
        }
        if sel.ed_g6 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 {
            put "; "
          }
          put sel.ed_g6 ": " sel.vl_v6
        }
        if sel.ed_g7 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 {
            put "; "
          }
          put sel.ed_g7 ": " sel.vl_v7
        }
        if sel.ed_g8 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 {
            put "; "
          }
          put sel.ed_g8 ": " sel.vl_v8
        }
        if sel.ed_g9 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 | sel.ed_g8 {
            put "; "
          }
          put sel.ed_g9 ": " sel.vl_v9
        }
        if sel.ed_g10 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 | sel.ed_g8 | sel.ed_g9 {
            put "; "
          }
          put sel.ed_g10 ": " sel.vl_v10
        }
        put ")"
      }
    }
    option main.ck_compat
    if main.cb_nb {
      put " nonbuyers(" main.cb_nb ")"
    }
    if se.rb_svy {
      put " vce(svy)"
    }
    if se.rb_none {
      put " vce(none)"
    }
    if se.rb_boot {
      require se.ed_reps
      put " vce(bootstrap, reps(" se.ed_reps ")"
      if se.ed_seed {
        put " seed(" se.ed_seed ")"
      }
      if se.ck_bsvy {
        put " svy"
      }
      if !se.ck_bsvy & se.vn_strata {
        put " strata(" se.vn_strata ")"
      }
      if !se.ck_bsvy & se.vn_psu {
        put " psu(" se.vn_psu ")"
      }
      if se.ck_short {
        put " shortcut"
      }
      put ")"
    }
    if rpt.rb_ind {
      put " elasticities(individuals)"
    }
    if rpt.rb_mkt {
      put " elasticities(market)"
    }
    optionarg /hidedefault rpt.sp_level
    optionarg /hidedefault rpt.sp_dec
    option rpt.ck_stars
    if !se.rb_none {
      option rpt.ck_seall
    }
    if rpt.ck_dreg {
      put " dregres(1)"
    }
    option rpt.ck_notab
    optionarg rpt.vn_hgroup
    if rpt.fi_save {
      optionarg /quoted rpt.fi_save
    }
  endoptions
END

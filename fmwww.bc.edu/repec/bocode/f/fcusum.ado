*! version 1.1.4  24nov2026  Taha Zaghdoudi, zedtaha@gmail.com
*! Fourier CUSUM test for the null of cointegration
*! Stata port of the R package FCUSUM 1.1.0 (CRAN)

program define fcusum, rclass sortpreserve
    version 14.0

    syntax varlist(min=2 numeric ts) [if] [in] [, ///
        KSTAR(integer 3)                          ///
        FREQ(string)                              ///
        FOURier(string)                           ///
        PREtest(real 0.05)                        ///
        CV(string)                                ///
        BOOT(string)                              ///
        REPS(integer 499)                         ///
        Q(integer -1)                             ///
        QMAX(integer -1)                          ///
        BW(string)                                ///
        STEP(real 0.01)                           ///
        SEED(string)                              ///
        RESID(name)                               ///
        GRAPH                                     ///
        GLEVel(integer 5)                         ///
        noCOEF                                    ///
        ]

    // ---- options -----------------------------------------------------------
    _fcusum_opt freq    "`freq'"    "fractional integer" "fractional"
    local freq `s(choice)'
    _fcusum_opt fourier "`fourier'" "auto always never"  "auto"
    local fourier `s(choice)'
    _fcusum_opt cv      "`cv'"      "bootstrap table"    "bootstrap"
    local cv `s(choice)'
    _fcusum_opt boot    "`boot'"    "iid sieve"          "iid"
    local boot `s(choice)'
    _fcusum_opt bw      "`bw'"      "nw kurozumi andrews" "nw"
    local bw `s(choice)'

    if `kstar' < 1 {
        di as err "kstar() must be a positive integer"
        exit 198
    }
    if `step' <= 0 | `step' > 1 {
        di as err "step() must be in (0, 1]"
        exit 198
    }
    if `pretest' <= 0 | `pretest' >= 1 {
        di as err "pretest() must be in (0, 1)"
        exit 198
    }
    if `reps' < 19 {
        di as err "reps() must be at least 19"
        exit 198
    }
    if `q' < -1 {
        di as err "q() must be a non-negative integer"
        exit 198
    }
    if `qmax' < -1 {
        di as err "qmax() must be a non-negative integer"
        exit 198
    }
    if !inlist(`glevel', 1, 5, 10) {
        di as err "glevel() must be 1, 5 or 10"
        exit 198
    }
    if "`resid'" != "" confirm new variable `resid'

    // ---- time-series checks -----------------------------------------------
    capture tsset
    if _rc {
        di as err "data must be {bf:tsset}"
        exit 111
    }
    qui tsset
    if "`r(panelvar)'" != "" {
        di as err "fcusum is for a single time series; data are tsset as a panel"
        exit 459
    }
    local tvar   "`r(timevar)'"
    local tdelta = r(tdelta)

    marksample touse
    sort `tvar'
    qui count if `touse'
    local N = r(N)
    if `N' < 20 {
        di as err "insufficient observations (`N')"
        exit 2001
    }
    qui summarize `tvar' if `touse', meanonly
    if round((r(max) - r(min)) / `tdelta') + 1 != `N' {
        di as err "the estimation sample must not contain gaps in `tvar'"
        exit 498
    }

    gettoken depname xnames : varlist
    local xnames = strtrim("`xnames'")
    local p : word count `xnames'
    tsrevar `varlist'
    local tsvars `r(varlist)'
    gettoken ytmp xtmp : tsvars

    // ---- run --------------------------------------------------------------
    tempname bmat
    tempvar rvar pvar
    qui gen double `rvar' = .
    qui gen double `pvar' = .

    if "`seed'" != "" {
        local oldrng = c(rngstate)
        set seed `seed'
    }
    capture noisily mata: _fcusum_main("`ytmp'", "`xtmp'", "`xnames'",   ///
        "`touse'", `kstar', "`freq'", "`fourier'", `pretest', "`cv'",     ///
        "`boot'", `reps', `q', `qmax', "`bw'", `step', "`rvar'",          ///
        "`pvar'", "`bmat'")
    local rc = _rc
    if "`seed'" != "" set rngstate `oldrng'
    if `rc' exit `rc'

    // ---- display ----------------------------------------------------------
    local retained = cond(`fret', "retained", "dropped")
    if "`fourier'" != "auto" local retained `"`retained' (fourier(`fourier'))"'
    local pct = 100 * `pretest'

    di
    di as txt "Fourier CUSUM test for the null of cointegration"
    di as txt "{hline 66}"
    di as txt "H0: cointegration  |  H1: no cointegration"
    di as txt "Dependent variable: " as res "`depname'" ///
       as txt "   Regressors: " as res "`xnames'"
    di
    di as txt "Step 1 - Fourier pre-test (sup-F)"
    di as txt "  sup-F = " as res %8.4f `supf' ///
       as txt "   p-value: " as res "`supf_plab'" ///
       as txt "   (" `pct' "% c.v. = " as res %7.4f `supf_cvl' as txt ")"
    di as txt "  Selected frequency k-hat: " as res %6.0g `khat' ///
       as txt "  (`freq' grid, k* = `kstar')"
    di as txt "  Fourier terms `retained'"
    di
    di as txt "Step 2 - `test' test"
    di as txt "  CUSUM statistic: " as res %8.4f `stat' " `stars'"
    di as txt "  p-value:         " as res "`plab'"
    di as txt "  Critical values (`cvsrc'):"
    di as txt "    10%: " as res %7.4f `cv10' ///
       as txt "    5%: " as res %7.4f `cv5'  ///
       as txt "    1%: " as res %7.4f `cv1'
    di
    di as txt "Decision: " as res "`decision'"
    di
    di as txt "Both CUSUM statistics: Fourier = " as res %7.4f `statf' ///
       as txt "   Xiao-Phillips = " as res %7.4f `statp'
    di as txt "DOLS leads/lags: " as res `qsel' ///
       as txt "  |  Obs. used: " as res `nobs'  ///
       as txt "  |  Bartlett LRV: " as res %9.4g `lrv' ///
       as txt " (`bw', " as res `bwlags' as txt " lags)"

    if "`coef'" != "nocoef" {
        di
        di as txt "DOLS coefficients (`test' model)"
        di as txt "{hline 13}{c TT}{hline 14}"
        local names : colnames `bmat'
        local j 0
        foreach nm of local names {
            local ++j
            di as txt %12s abbrev("`nm'", 12) " {c |}" as res %13.5g `bmat'[1, `j']
        }
        di as txt "{hline 13}{c BT}{hline 14}"
        if `qsel' > 0 {
            di as txt "Leads/lags of D.x not shown. " _c
        }
        di as txt "OLS standard errors are not valid for DOLS inference."
    }

    // ---- optional outputs -------------------------------------------------
    if "`resid'" != "" {
        qui gen double `resid' = `rvar'
        label variable `resid' "fcusum residuals (`test' model)"
    }
    if "`graph'" != "" {
        local c = `cv`glevel''
        local mc = -`c'
        twoway (line `pvar' `tvar' if !missing(`pvar')),              ///
            yline(`mc' `c', lpattern(dash) lcolor(red))               ///
            yline(0, lcolor(gs10))                                    ///
            ytitle("Scaled CUSUM of residuals") xtitle("")            ///
            title("`test' path") legend(off)                          ///
            note("Dashed lines: `glevel'% critical value")
    }

    // ---- stored results ---------------------------------------------------
    return scalar stat         = `stat'
    return scalar p            = `pval'
    return scalar cv10         = `cv10'
    return scalar cv5          = `cv5'
    return scalar cv1          = `cv1'
    return scalar supF         = `supf'
    return scalar supF_p       = `supf_p'
    return scalar supF_cv      = `supf_cvl'
    return scalar supF_cv10    = `supf_cv10'
    return scalar supF_cv5     = `supf_cv5'
    return scalar supF_cv1     = `supf_cv1'
    return scalar fourier      = `fret'
    return scalar khat         = `khat'
    return scalar stat_fourier = `statf'
    return scalar stat_plain   = `statp'
    return scalar lrv          = `lrv'
    return scalar bwlags       = `bwlags'
    return scalar q            = `qsel'
    return scalar kstar        = `kstar'
    return scalar reps         = `reps'
    return scalar n_regs       = `p'
    return scalar N            = `nobs'
    return local  test     "`test'"
    return local  decision "`decision'"
    return local  cvsource "`cvsrc'"
    return local  freq     "`freq'"
    return local  bw       "`bw'"
    return local  boot     "`boot'"
    return local  depvar   "`depname'"
    return local  indepvars "`xnames'"
    return local  cmd      "fcusum"
    return matrix b = `bmat'
end

// Match a (possibly abbreviated) string option against allowed choices
program define _fcusum_opt, sclass
    args optname value choices default
    sreturn clear
    local value = lower(strtrim(`"`value'"'))
    if `"`value'"' == "" {
        sreturn local choice "`default'"
        exit
    }
    local hit
    local nhit 0
    foreach c of local choices {
        if `"`value'"' == substr("`c'", 1, length(`"`value'"')) {
            local hit `c'
            local ++nhit
        }
    }
    if `nhit' != 1 {
        di as err `"`optname'() must be one of: `choices'"'
        exit 198
    }
    sreturn local choice "`hit'"
end



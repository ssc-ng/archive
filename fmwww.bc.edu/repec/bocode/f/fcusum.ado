// ============================================================================
// Structures
// ============================================================================

struct _fcusum_fit {
    real scalar    stat, omega2, lags, nobs
    real colvector u, b
}

struct _fcusum_core {
    real scalar    khat, statf, statp, F, n, nobs, om0, L0
    real colvector b0, u0, tt
    real rowvector grid
    struct _fcusum_fit scalar f1
}

// ============================================================================
// Building blocks (mirror R/internal.R and R/lrv.R of FCUSUM 1.1.0)
// ============================================================================

// DOLS design: constant, levels of x, q leads and lags of D.x.
// Estimation sample is (trim + 2) .. (n - trim).
void _fcusum_dols(real colvector y, real matrix X, real scalar q,
                  real scalar trim, real colvector yy, real matrix Z,
                  real colvector tt)
{
    real scalar n, p, l
    real matrix dx

    n  = rows(y)
    p  = cols(X)
    dx = J(1, p, .) \ (X[|2, 1 \ n, p|] - X[|1, 1 \ n - 1, p|])
    tt = (trim + 2 :: n - trim)
    yy = y[tt]
    Z  = J(rows(tt), 1, 1), X[tt, .]
    for (l = -q; l <= q; l++) Z = Z, dx[tt :+ l, .]
}

// OLS residuals (QR based)
real matrix _fcusum_res(real matrix Z, real matrix Y)
{
    return(Y - Z * qrsolve(Z, Y))
}

// Number of DOLS leads/lags by BIC on a common sample
real scalar _fcusum_selq(real colvector y, real matrix X, real scalar qmax)
{
    real scalar    q, m, bic, best, qbest
    real colvector yy, tt, e
    real matrix    Z

    best  = .
    qbest = 0
    for (q = 0; q <= qmax; q++) {
        _fcusum_dols(y, X, q, qmax, yy, Z, tt)
        m = rows(yy)
        if (m - cols(Z) < 1) continue
        e   = _fcusum_res(Z, yy)
        bic = m * ln(sum(e:^2) / m) + cols(Z) * ln(m)
        if (bic < best) {
            best  = bic
            qbest = q
        }
    }
    return(qbest)
}

// Frequency grid
real rowvector _fcusum_grid(real scalar kstar, string scalar freq,
                            real scalar step)
{
    real scalar K
    if (freq == "integer") return(1..kstar)
    K = floor((kstar - 0.1) / step + 1e-10)
    return(round(0.1 :+ step :* (0..K), 1e-10))
}

// RSS of yy ~ Z + cos(2 pi k t/n) + sin(2 pi k t/n) for every k in grid
// (Frisch-Waugh-Lovell, one QR decomposition)
real rowvector _fcusum_fsearch(real colvector yy, real matrix Z,
                               real colvector tt, real scalar n,
                               real rowvector grid)
{
    real scalar    G, j
    real matrix    arg, R, RC, RS
    real colvector ey
    real rowvector a, b, d, g1, g2, dt, ess, rss

    G   = cols(grid)
    arg = (2 * pi() / n) :* (tt * grid)
    R   = _fcusum_res(Z, (yy, cos(arg), sin(arg)))
    ey  = R[., 1]
    RC  = R[|1, 2 \ rows(R), G + 1|]
    RS  = R[|1, G + 2 \ rows(R), 2 * G + 1|]
    a   = colsum(RC:^2)
    b   = colsum(RC :* RS)
    d   = colsum(RS:^2)
    g1  = colsum(RC :* ey)
    g2  = colsum(RS :* ey)
    dt  = a :* d - b:^2
    ess = (d :* g1:^2 - 2 :* b :* g1 :* g2 + a :* g2:^2) :/ dt
    rss = sum(ey:^2) :- ess
    for (j = 1; j <= G; j++) {
        if (rss[j] >= . | dt[j] <= 1e-10 * a[j] * d[j]) rss[j] = maxdouble()
    }
    return(rss)
}

// Index of the first minimum
real scalar _fcusum_argmin(real rowvector v)
{
    real scalar j, jb
    jb = 1
    for (j = 2; j <= cols(v); j++) if (v[j] < v[jb]) jb = j
    return(jb)
}

real scalar _fcusum_andS(real scalar r, real scalar n)
{
    return(1.1447 * (4 * r^2 * n / ((1 + r)^2 * (1 - r)^2))^(1 / 3))
}

// Bartlett long-run variance; returns (omega2, lags)
real rowvector _fcusum_lrv(real colvector u0, string scalar bw)
{
    real scalar    n, S, rho, L, s, l
    real colvector u

    u = u0 :- mean(u0)
    n = rows(u)
    if (bw == "nw") {
        S = 4 * (n / 100)^(2 / 9)
    }
    else {
        rho = sum(u[|2 \ n|] :* u[|1 \ n - 1|]) / sum(u[|1 \ n - 1|]:^2)
        if (bw == "andrews") {
            rho = max((min((rho, 0.97)), -0.97))
            S   = _fcusum_andS(rho, n)
        }
        else {
            rho = max((min((rho, 0.999)), -0.999))
            S   = min((_fcusum_andS(rho, n), _fcusum_andS(0.7, n)))
        }
    }
    L = floor(S)
    if (L > n - 2) L = n - 2
    s = sum(u:^2) / n
    for (l = 1; l <= L; l++) {
        s = s + 2 * (1 - l / (L + 1)) * sum(u[|l + 1 \ n|] :* u[|1 \ n - l|]) / n
    }
    if (s < epsilon(1)) s = epsilon(1)
    return((s, L))
}

real scalar _fcusum_cusum(real colvector u, real scalar omega2)
{
    return(max(abs(runningsum(u))) / (sqrt(omega2) * sqrt(rows(u))))
}

// DOLS with the Fourier pair at frequency k, and its CUSUM statistic
struct _fcusum_fit scalar _fcusum_fitk(real colvector yy, real matrix Z,
                                       real colvector tt, real scalar n,
                                       real scalar k, string scalar bw)
{
    struct _fcusum_fit scalar f
    real matrix    X
    real rowvector lv

    X      = Z, cos(2 * pi() * k :* tt / n), sin(2 * pi() * k :* tt / n)
    f.b    = qrsolve(X, yy)
    f.u    = yy - X * f.b
    lv     = _fcusum_lrv(f.u, bw)
    f.omega2 = lv[1]
    f.lags   = lv[2]
    f.nobs   = rows(f.u)
    f.stat   = _fcusum_cusum(f.u, f.omega2)
    return(f)
}

// Full procedure on one sample
struct _fcusum_core scalar _fcusum_runcore(real colvector y, real matrix X,
                                        real scalar q, string scalar bw,
                                        real rowvector grid)
{
    struct _fcusum_core scalar c
    real colvector yy, tt
    real matrix    Z
    real rowvector rss, lv

    c.n    = rows(y)
    c.grid = grid
    _fcusum_dols(y, X, q, q, yy, Z, tt)
    c.tt   = tt
    rss    = _fcusum_fsearch(yy, Z, tt, c.n, grid)
    c.khat = grid[_fcusum_argmin(rss)]
    c.f1   = _fcusum_fitk(yy, Z, tt, c.n, c.khat, bw)
    c.b0   = qrsolve(Z, yy)
    c.u0   = yy - Z * c.b0
    c.nobs = rows(c.u0)
    lv     = _fcusum_lrv(c.u0, bw)
    c.om0  = lv[1]
    c.L0   = lv[2]
    c.statp = _fcusum_cusum(c.u0, c.om0)
    c.statf = c.f1.stat
    c.F    = ((sum(c.u0:^2) - sum(c.f1.u:^2)) / 2) / c.f1.omega2
    return(c)
}

// p independent Gaussian random walks
real matrix _fcusum_rw(real scalar n, real scalar p)
{
    real matrix X
    real scalar j
    X = rnormal(n, p, 0, 1)
    for (j = 1; j <= p; j++) X[., j] = runningsum(X[., j])
    return(X)
}

// ============================================================================
// Bootstrap and simulation (mirror .boot_fourier and fcum_cv_sim)
// ============================================================================

// AR(m) by OLS with intercept on demeaned data, m = 0..pmax chosen by AIC
// (as stats::ar(method = "ols", aic = TRUE, demean = TRUE)).
// Returns the AR coefficients (possibly empty); residuals in e.
real rowvector _fcusum_arfit(real colvector u, real scalar pmax,
                             real colvector e)
{
    real scalar    n, m, j, aic, best
    real colvector x, Y, bm, E
    real matrix    Xm
    real rowvector phi

    x    = u :- mean(u)
    n    = rows(x)
    best = .
    phi  = J(1, 0, .)
    for (m = 0; m <= pmax; m++) {
        Y  = x[|m + 1 \ n|]
        Xm = J(n - m, 1, 1)
        for (j = 1; j <= m; j++) Xm = Xm, x[|m + 1 - j \ n - j|]
        bm  = qrsolve(Xm, Y)
        E   = Y - Xm * bm
        aic = n * ln(sum(E:^2) / (n - m)) + 2 * (m + 1)
        if (aic < best) {
            best = aic
            e    = E
            if (m > 0) phi = bm[|2 \ m + 1|]'
            else       phi = J(1, 0, .)
        }
    }
    return(phi)
}

real colvector _fcusum_boot(struct _fcusum_core scalar c, real scalar p,
                            real scalar q, string scalar bw, real scalar B,
                            string scalar type)
{
    real scalar    n, sc, nb, a1, a2, k, b, t, j, burn, ne
    real colvector tt, brk, e, draws, u, eb, yy, ttb, ys
    real rowvector phi, rss
    real matrix    X, Z
    complex rowvector rt
    struct _fcusum_fit scalar fb

    n   = c.n
    tt  = (1 :: n)
    sc  = sqrt(c.f1.omega2)
    nb  = rows(c.f1.b)
    a1  = c.f1.b[nb - 1] / sc
    a2  = c.f1.b[nb] / sc
    k   = c.khat
    brk = a1 :* cos(2 * pi() * k :* tt / n) + a2 :* sin(2 * pi() * k :* tt / n)

    burn = 50
    if (type == "sieve") {
        phi = _fcusum_arfit(c.f1.u, 4, e)
        if (cols(phi)) {
            if (sum(phi) > 0.9) phi = phi :* (0.9 / sum(phi))
            rt = polyroots((1, -phi))
            if (any(abs(rt) :< 1.02)) phi = J(1, 0, .)
        }
        e  = (e :- mean(e)) :/ sc
        ne = rows(e)
    }

    draws = J(B, 1, .)
    for (b = 1; b <= B; b++) {
        X = _fcusum_rw(n, p)
        if (type == "iid") {
            u = rnormal(n, 1, 0, 1)
        }
        else {
            eb = e[floor(runiform(n + burn, 1) :* ne) :+ 1]
            u  = eb
            for (t = 2; t <= n + burn; t++) {
                for (j = 1; j <= cols(phi); j++) {
                    if (t - j >= 1) u[t] = u[t] + phi[j] * u[t - j]
                }
            }
            u = u[|burn + 1 \ n + burn|]
        }
        ys  = brk + u
        _fcusum_dols(ys, X, q, q, yy, Z, ttb)
        rss = _fcusum_fsearch(yy, Z, ttb, n, c.grid)
        fb  = _fcusum_fitk(yy, Z, ttb, n, c.grid[_fcusum_argmin(rss)], bw)
        draws[b] = fb.stat
    }
    return(draws)
}

// Null distribution under cointegration without break
//   type "plain": Xiao-Phillips CUSUM;  "supF": sup-F;  "fixed": Fourier CUSUM at k
real colvector _fcusum_sim(real scalar n, real scalar p, string scalar type,
                           real scalar k, real rowvector grid, real scalar q,
                           string scalar bw, real scalar nsim)
{
    real scalar    i
    real colvector draws, y, yy, tt, u
    real rowvector lv
    real matrix    X, Z
    struct _fcusum_fit  scalar f
    struct _fcusum_core scalar c

    draws = J(nsim, 1, .)
    for (i = 1; i <= nsim; i++) {
        X = _fcusum_rw(n, p)
        y = rnormal(n, 1, 0, 1)
        if (type == "fixed") {
            _fcusum_dols(y, X, q, q, yy, Z, tt)
            f = _fcusum_fitk(yy, Z, tt, n, k, bw)
            draws[i] = f.stat
        }
        else if (type == "plain") {
            _fcusum_dols(y, X, q, q, yy, Z, tt)
            u = _fcusum_res(Z, yy)
            lv = _fcusum_lrv(u, bw)
            draws[i] = _fcusum_cusum(u, lv[1])
        }
        else {
            c = _fcusum_runcore(y, X, q, bw, grid)
            draws[i] = c.F
        }
    }
    return(draws)
}

// ============================================================================
// Critical values and p-values (mirror R/critical_values.R)
// ============================================================================

// Linear interpolation of yv(xv) at x0, constant outside (approx(rule = 2))
real scalar _fcusum_interp(real vector xv, real vector yv, real scalar x0)
{
    real scalar j, n
    n = length(xv)
    if (x0 <= xv[1]) return(yv[1])
    if (x0 >= xv[n]) return(yv[n])
    for (j = 1; j < n; j++) {
        if (x0 <= xv[j + 1]) {
            return(yv[j] + (yv[j + 1] - yv[j]) * (x0 - xv[j]) / (xv[j + 1] - xv[j]))
        }
    }
    return(yv[n])
}

// Quantile, R type 7
real scalar _fcusum_q7(real colvector x, real scalar pr)
{
    real colvector s
    real scalar    h, lo
    s  = sort(x, 1)
    h  = (rows(s) - 1) * pr + 1
    lo = floor(h)
    if (lo >= rows(s)) return(s[rows(s)])
    return(s[lo] + (h - lo) * (s[lo + 1] - s[lo]))
}

// From tabulated quantiles: cv = (10%, 5%, 1%), p-value, label
void _fcusum_cvtab(real scalar stat, real rowvector qv, real rowvector cv,
                   real scalar pv, string scalar plab)
{
    real rowvector pr
    pr = _fcusum_probs()
    cv = (qv[5], qv[7], qv[9])
    if (stat >= max(qv)) {
        pv   = 1 - max(pr)
        plab = "< " + strofreal(pv, "%4.2f")
    }
    else if (stat <= min(qv)) {
        pv   = 1 - min(pr)
        plab = "> " + strofreal(pv, "%4.2f")
    }
    else {
        pv   = 1 - _fcusum_interp(qv, pr, stat)
        plab = strofreal(round(pv, 0.001), "%5.3f")
    }
}

// From simulated / bootstrap draws
void _fcusum_cvdraws(real scalar stat, real colvector dr, real rowvector cv,
                     real scalar pv, string scalar plab)
{
    cv   = (_fcusum_q7(dr, 0.90), _fcusum_q7(dr, 0.95), _fcusum_q7(dr, 0.99))
    pv   = (1 + sum(dr :>= stat)) / (rows(dr) + 1)
    plab = strofreal(pv, "%5.3f")
}

// Fixed-frequency table row interpolated in k (p <= 4, 0.1 <= k <= 5)
real rowvector _fcusum_fixedq(real scalar p, real scalar k)
{
    real matrix    T
    real colvector kk
    real rowvector out
    real scalar    j
    T   = _fcusum_tab_fixed()
    T   = T[|50 * (p - 1) + 1, 1 \ 50 * p, 9|]
    kk  = (1 :: 50) :/ 10
    out = J(1, 9, .)
    for (j = 1; j <= 9; j++) out[j] = _fcusum_interp(kk, T[., j], k)
    return(out)
}

// ============================================================================
// Main entry point called by fcusum.ado
// ============================================================================

void _fcusum_main(string scalar yname, string scalar xvars,
                  string scalar xlabels, string scalar touse,
                  real scalar kstar, string scalar freq,
                  string scalar fourier, real scalar plevel,
                  string scalar cvtype, string scalar boot, real scalar reps,
                  real scalar q, real scalar qmax, string scalar bw,
                  real scalar step, string scalar rvar, string scalar pvar,
                  string scalar bname)
{
    real colvector y, yy, tt, dr, u, obs, b
    real matrix    X, Z
    real scalar    n, p, usef, stat, pv, Fpv, cvlev, om, L, m, nb
    real rowvector grid, cv, Fcv, qrow
    real matrix    TT
    string scalar  plab, Fplab, test, cvsrc, dec, stars
    string rowvector xl, cn
    struct _fcusum_core scalar c

    y  = st_data(., yname, touse)
    X  = st_data(., tokens(xvars), touse)
    xl = tokens(xlabels)
    n  = rows(y)
    p  = cols(X)

    if (qmax < 0) qmax = min((4, floor(4 * (n / 100)^(1 / 4))))

    // ---- step 1: DOLS + frequency search ------------------------------------
    if (q < 0) q = _fcusum_selq(y, X, qmax)
    _fcusum_dols(y, X, q, q, yy, Z, tt)
    if (rows(yy) - cols(Z) - 2 < 10) {
        errprintf("too few observations for %g regressor(s) and q = %g leads/lags\n",
                  p, q)
        exit(2001)
    }
    grid = _fcusum_grid(kstar, freq, step)
    c    = _fcusum_runcore(y, X, q, bw, grid)

    // ---- step 2: sup-F pre-test ---------------------------------------------
    if (p <= 4 & kstar <= 5 & (freq == "integer" | abs(step - 0.01) < 1e-12)) {
        TT   = _fcusum_tab_supf()
        qrow = TT[20 * (freq == "integer") + 4 * (kstar - 1) + p, .]
        _fcusum_cvtab(c.F, qrow, Fcv, Fpv, Fplab)
        cvlev = _fcusum_interp(_fcusum_probs(), qrow, 1 - plevel)
    }
    else {
        printf("{txt}sup-F critical values not tabulated for this configuration; simulating (%g reps).\n", reps)
        dr = _fcusum_sim(n, p, "supF", 1, grid, q, bw, reps)
        _fcusum_cvdraws(c.F, dr, Fcv, Fpv, Fplab)
        cvlev = _fcusum_q7(dr, 1 - plevel)
    }
    if (fourier == "auto")        usef = (c.F > cvlev)
    else if (fourier == "always") usef = 1
    else                          usef = 0

    // ---- step 3: CUSUM test ---------------------------------------------------
    if (usef) {
        test = "Fourier CUSUM"
        stat = c.statf
        if (cvtype == "bootstrap") {
            dr = _fcusum_boot(c, p, q, bw, reps, boot)
            _fcusum_cvdraws(stat, dr, cv, pv, plab)
            cvsrc = boot + " bootstrap, " + strofreal(reps) + " reps"
        }
        else if (p <= 4 & c.khat >= 0.1 & c.khat <= 5) {
            _fcusum_cvtab(stat, _fcusum_fixedq(p, c.khat), cv, pv, plab)
            cvsrc = "asymptotic table, fixed frequency"
        }
        else {
            printf("{txt}Outside the fixed-frequency table; simulating (%g reps).\n", reps)
            dr = _fcusum_sim(n, p, "fixed", c.khat, grid, q, bw, reps)
            _fcusum_cvdraws(stat, dr, cv, pv, plab)
            cvsrc = "simulated, fixed frequency"
        }
        u  = c.f1.u
        b  = c.f1.b
        om = c.f1.omega2
        L  = c.f1.lags
    }
    else {
        test = "Xiao-Phillips CUSUM"
        stat = c.statp
        if (p <= 4) {
            TT   = _fcusum_tab_plain()
            qrow = TT[p, .]
            _fcusum_cvtab(stat, qrow, cv, pv, plab)
            cvsrc = "asymptotic table"
        }
        else {
            printf("{txt}Plain CUSUM table covers p <= 4; simulating (%g reps).\n", reps)
            dr = _fcusum_sim(n, p, "plain", 1, grid, q, bw, reps)
            _fcusum_cvdraws(stat, dr, cv, pv, plab)
            cvsrc = "simulated"
        }
        u  = c.u0
        b  = c.b0
        om = c.om0
        L  = c.L0
    }

    if (stat > cv[3]) {
        dec   = "Reject H0 (cointegration) at the 1% level"
        stars = "***"
    }
    else if (stat > cv[2]) {
        dec   = "Reject H0 (cointegration) at the 5% level"
        stars = "**"
    }
    else if (stat > cv[1]) {
        dec   = "Reject H0 (cointegration) at the 10% level"
        stars = "*"
    }
    else {
        dec   = "Fail to reject H0: evidence of cointegration"
        stars = ""
    }

    // ---- variables: residuals and scaled CUSUM path -----------------------------
    m   = rows(u)
    obs = selectindex(st_data(., touse))
    obs = obs[c.tt]
    st_store(obs, rvar, u)
    st_store(obs, pvar, runningsum(u) / (sqrt(om) * sqrt(m)))

    // ---- coefficients: constant, levels of x, Fourier pair ------------------------
    nb = 1 + p
    cn = ("_cons", xl)
    if (usef) {
        st_matrix(bname, (b[|1 \ nb|] \ b[|rows(b) - 1 \ rows(b)|])')
        cn = cn, ("cos_k", "sin_k")
    }
    else {
        st_matrix(bname, b[|1 \ nb|]')
    }
    st_matrixcolstripe(bname, (J(cols(cn), 1, ""), cn'))
    st_matrixrowstripe(bname, ("", "coef"))

    // ---- locals for the ado-file ------------------------------------------------
    st_local("test",      test)
    st_local("stat",      strofreal(stat,  "%21.0g"))
    st_local("pval",      strofreal(pv,    "%21.0g"))
    st_local("plab",      plab)
    st_local("cv10",      strofreal(cv[1], "%21.0g"))
    st_local("cv5",       strofreal(cv[2], "%21.0g"))
    st_local("cv1",       strofreal(cv[3], "%21.0g"))
    st_local("cvsrc",     cvsrc)
    st_local("decision",  dec)
    st_local("stars",     stars)
    st_local("supf",      strofreal(c.F,   "%21.0g"))
    st_local("supf_p",    strofreal(Fpv,   "%21.0g"))
    st_local("supf_plab", Fplab)
    st_local("supf_cvl",  strofreal(cvlev, "%21.0g"))
    st_local("supf_cv10", strofreal(Fcv[1], "%21.0g"))
    st_local("supf_cv5",  strofreal(Fcv[2], "%21.0g"))
    st_local("supf_cv1",  strofreal(Fcv[3], "%21.0g"))
    st_local("fret",      strofreal(usef))
    st_local("khat",      strofreal(c.khat, "%21.0g"))
    st_local("statf",     strofreal(c.statf, "%21.0g"))
    st_local("statp",     strofreal(c.statp, "%21.0g"))
    st_local("qsel",      strofreal(q))
    st_local("nobs",      strofreal(m))
    st_local("lrv",       strofreal(om, "%21.0g"))
    st_local("bwlags",    strofreal(L))
}

end

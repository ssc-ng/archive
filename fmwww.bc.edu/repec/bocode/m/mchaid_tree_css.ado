@font-face {
  font-family: 'Roboto';
  font-style: normal;
  font-weight: 400;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
@font-face {
  font-family: 'Roboto';
  font-style: normal;
  font-weight: 400;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #fff;
  font-family: Roboto, Arial, Helvetica, sans-serif; color: #222; }
svg#tree { position: absolute; left: 0; top: 0; width: 100%; height: 100%; cursor: grab; user-select: none; }
svg#tree:active { cursor: grabbing; }
#title { position: absolute; left: 16px; top: 10px; margin: 0; font-size: 22px; font-weight: 400; pointer-events: none; z-index: 2; }
#bar { position: absolute; right: 12px; top: 10px; display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; z-index: 3; }
#bar button { font: 13px Roboto, Arial, sans-serif; min-width: 32px; height: 30px; padding: 0 9px; border: 1px solid #bbb; border-radius: 4px;
  background: #fafafa; color: #333; cursor: pointer; }
#bar button:hover { background: #e9eef6; border-color: #7a9bd0; }
#bar .sep { width: 8px; }
#tip { position: fixed; z-index: 10; pointer-events: none; display: none; max-width: 360px; padding: 8px 11px; border-radius: 5px;
  background: rgba(30, 30, 30, 0.93); color: #f4f4f4; font-size: 12.5px; line-height: 1.45; box-shadow: 0 2px 8px rgba(0,0,0,.35); }
#tip b { color: #fff; }
#tip .def { color: #c8d4e6; }
#tip .sp { color: #ffd98a; }
#tip table.dist { border-collapse: collapse; margin: 4px 0 2px; }
#tip table.dist td { padding: 1px 8px 1px 0; font-size: 12px; }
#tip table.dist td:not(:first-child) { text-align: right; }
#tip table.dist i { display: inline-block; width: 10px; height: 10px; margin-right: 6px; border: 1px solid rgba(255,255,255,.5); vertical-align: -1px; }
.node, .split .tgl { cursor: pointer; }
